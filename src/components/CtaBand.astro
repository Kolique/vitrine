---
import { SITE, CTA_LABEL } from "../config";

interface Props {
  title?: string;
  text?: string;
}

const {
  title = "Parlons-en directement : 20 minutes, en visio",
  text = "Un appel gratuit, sans engagement, avec l'auditeur lui-même. On regarde votre site, je vous présente les offres adaptées à votre situation et vous recevez un devis précis sous 48 h.",
} = Astro.props;
---

<section aria-labelledby="cta-titre">
  <div class="wrap">
    <div class="cta-band on-dark">
      <h2 id="cta-titre">{title}</h2>
      <p>{text}</p>
      <a class="btn btn-primary" href="/reserver/">{CTA_LABEL}</a>
      <p style="margin-top:1rem;font-size:0.92rem">
        Vous préférez écrire&nbsp;?
        <a href={`mailto:${SITE.auditeur.email}`}>{SITE.auditeur.email}</a>
      </p>
    </div>
  </div>
</section>
