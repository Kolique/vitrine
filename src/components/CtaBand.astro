---
import { SITE, CTA_LABEL } from "../config";

interface Props {
  title?: string;
  text?: string;
}

const {
  title = "Faisons le point en 20 minutes",
  text = "Un appel gratuit, sans engagement. Vous repartez avec une première idée de votre niveau de conformité et des priorités — que l'on travaille ensemble ou non.",
} = Astro.props;
---

<section aria-labelledby="cta-titre">
  <div class="wrap">
    <div class="cta-band on-dark">
      <h2 id="cta-titre">{title}</h2>
      <p>{text}</p>
      <a class="btn btn-primary" href={SITE.calendly}>{CTA_LABEL}</a>
      <p style="margin-top:1rem;font-size:0.92rem">
        Vous préférez écrire&nbsp;?
        <a href={`mailto:${SITE.auditeur.email}`}>{SITE.auditeur.email}</a>
      </p>
    </div>
  </div>
</section>
